#. Translators: application name, as used in the window manager, the window title, the about dialog...
#: editor/ca.desrt.dconf-editor.desktop.in:2 editor/dconf-editor.vala:21
msgid "dconf Editor"
msgstr "dconf-redigering"

#. Translators: a GenericName that gives the application goal, as defined in the desktop file spec
#: editor/ca.desrt.dconf-editor.desktop.in:4
msgid "Configuration editor for dconf"
msgstr "Oppsettredigering for dconf"

#. Translators: a Comment that gives the application function, as defined in the desktop file spec
#: editor/ca.desrt.dconf-editor.desktop.in:6
msgid "Directly edit your entire configuration database"
msgstr "Rediger oppsettdatabasen din direkte"

#. Translators: some search Keywords to find this application, as defined in the desktop file spec. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: editor/ca.desrt.dconf-editor.desktop.in:8
msgid "settings;configuration;"
msgstr "innstillingar;oppsett;"

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:9
msgid "Dconf Editor"
msgstr "Dconf-redigering"

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:10
msgid "A graphical tool for editing the dconf database"
msgstr "Eit grafisk verktøy for redigering av dconf-databasen"

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:13
msgid ""
"Dconf Editor is a tool to allow direct editing of the dconf configuration "
"database. This is useful when developing applications that use these "
"settings."
msgstr ""
"Dconf Editor er eit verktøy som gjev direkte redigering av dconf-oppsettet. "
"Dette er nyttig når du utviklar appar som brukar desse innstillingane."

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:17
msgid ""
"Editing your configuration directly is an advanced feature and may cause "
"applications to not work correctly."
msgstr ""
"Å redigere oppsettet ditt direkte er ein avansert funksjon og kan føre til "
"at appane ikkje fungerer korrekt."

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:37
msgid "Browse the keys used by installed applications"
msgstr "Vitje nøklane som er brukte av installerte appar"

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:41
msgid "Read keys descriptions and edit their values"
msgstr "Les nøkkel-skildringar og rediger verdiane deira"

#: editor/ca.desrt.dconf-editor.metainfo.xml.in:59
msgid "The GNOME Project"
msgstr "GNOME-prosjektet"

